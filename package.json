{
  "name": "@parkwherever/react-native-app-clip",
  "version": "0.2.4",
  "description": "Config plugin to add an App Clip to a React Native iOS app",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "ios",
    "plugin/build",
    "build",
    "README.md",
    "expo-module.config.json",
    "app.plugin.js"
  ],
  "scripts": {
    "ncu": "bun x npm-check-updates -p bun",
    "build": "bun x tsc --build ./ ./plugin",
    "dev": "bun x tsc --build ./ ./plugin --watch"
  },
  "keywords": [
    "react-native",
    "expo",
    "react-native-app-clip",
    "ReactNativeAppClip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndkt/react-native-app-clip.git"
  },
  "bugs": {
    "url": "https://github.com/bndkt/react-native-app-clip/issues"
  },
  "author": "Benedikt Müller <91166910+bndkt@users.noreply.github.com> (https://bndkt.com)",
  "license": "MIT",
  "homepage": "https://github.com/bndkt/react-native-app-clip#readme",
  "dependencies": {
    "@expo/config-plugins": "^7.9.0",
    "@expo/plist": "^0.0.20"
  },
  "devDependencies": {
    "@types/react": "^18.2.46",
    "expo-module-scripts": "^4.0.2",
    "expo-modules-core": "^2.1.1",
    "prettier": "^3.0.3",
    "react": "^18.3.1",
    "react-native": "~0.76.3",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
